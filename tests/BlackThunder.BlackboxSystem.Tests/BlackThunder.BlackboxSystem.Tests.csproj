<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsTestProject>true</IsTestProject>
    <DefineConstants>$(DefineConstants);BLACKBOX_TESTS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BlackboxLockHandles)' == 'true'">
    <DefineConstants>$(DefineConstants);BLACKBOX_LOCK_HANDLES</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\BlackThunder.BlackboxSystem\**\*.cs"
             Exclude="..\..\src\BlackThunder.BlackboxSystem\**\bin\**;..\..\src\BlackThunder.BlackboxSystem\**\obj\**"
             LinkBase="Blackbox\Runtime" />
    <Compile Include="*.cs" LinkBase="Blackbox\Tests" />
    <Compile Include="UniTest\*.cs" LinkBase="Blackbox\Tests\UniTest" />
    <PackageReference Include="BlackThunder.UniTest" Version="[0.4.0]" PrivateAssets="all" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    <ProjectReference Include="../../samples/BlackThunder.BlackboxSystem.Samples.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopySampleApplication" AfterTargets="Build">
    <MSBuild Projects="../../samples/BlackThunder.BlackboxSystem.Samples.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="SampleAssemblyPath" />
    </MSBuild>
    <ItemGroup>
      <SampleApplicationFiles Include="%(SampleAssemblyPath.RootDir)%(SampleAssemblyPath.Directory)*" />
    </ItemGroup>
    <Error Condition="'@(SampleApplicationFiles)' == ''" Text="The built sample application could not be located." />
    <Copy SourceFiles="@(SampleApplicationFiles)" DestinationFolder="$(OutDir)SampleApp" SkipUnchangedFiles="true" />
  </Target>
</Project>
